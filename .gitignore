# Upstream source archives downloaded by spectool during local SRPM builds
/*.tar.gz
/packages/*/*.tar.gz

# Yazi's curated bundles are committed for offline builds and license provenance
!/packages/yazi/yazi-*-vendor.tar.gz
!/packages/yazi/yazi-*-syntax-sources.tar.gz

# RPM build artifacts and local build results
*.rpm
dist/

# Python bytecode generated by local validation
__pycache__/
*.py[cod]
